<launch>
  <arg name="namespace" default="pinky1" description="로봇 네임스페이스 (pinky1 | pinky2)"/>

  <node pkg="pinky_camera" exec="camera_node" name="camera_node" namespace="$(var namespace)" output="screen">
    <param from="$(find-pkg-share pinky_camera)/config/camera_params.yaml"/>
  </node>
</launch>
