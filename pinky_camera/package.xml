<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pinky_camera</name>
  <version>0.1.0</version>
  <description>Pinky 로봇 CSI 카메라(picamera2) 영상을 ROS2 CompressedImage 토픽으로 발행하는 패키지</description>
  <maintainer email="you@example.com">your_name</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <!-- lane_detector_node(PC)는 pip 패키지 ultralytics가 필요함 (rosdep 키 없음) -->
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-picamera2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
